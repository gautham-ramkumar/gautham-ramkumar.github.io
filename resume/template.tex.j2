% =====================================================================
% Generated by resume/build.py — DO NOT EDIT BY HAND.
% Edit resume/content.yaml or resume/profiles.yaml instead.
%
% Layout is Gautham's own tailored resume design, parameterised so each
% domain profile emits the same look with a different project selection.
%
% Jinja delimiters are remapped to avoid clashing with LaTeX braces:
% variables use doubled angle brackets, blocks use angle-bracket-percent,
% and comments use angle-bracket-hash. See build.py for the exact config.
%
% Optional fields are read with .get(), because build.py deletes any field
% still marked TODO and the environment uses StrictUndefined. Skill items
% are read as row['items'], since dotted access would resolve to Python's
% dict.items method instead of the YAML key.
% =====================================================================
\documentclass[10pt,letterpaper]{article}

\usepackage[margin=0.5in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{textcomp}
\usepackage{helvet}\renewcommand{\familydefault}{\sfdefault}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage[hidelinks]{hyperref}

\hyphenpenalty=10000
\exhyphenpenalty=10000
\sloppy
\spaceskip=3.6pt plus 1.2pt minus 0.9pt

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\titleformat{\section}{\large\bfseries}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{5pt}{4pt}

\setlist[itemize]{leftmargin=1.8em, itemsep=2pt, parsep=0pt,
                  topsep=3pt, partopsep=0pt, label=\textbullet}

\newcommand{\entryhead}[2]{%
  \noindent\textbf{#1}\hfill #2\par
}

\newlength{\skilllabelw}\setlength{\skilllabelw}{1.6in}
\newcommand{\skillrow}[2]{%
  \noindent\begin{minipage}[t]{\skilllabelw}\textbf{#1}\end{minipage}%
  \begin{minipage}[t]{\dimexpr\linewidth-\skilllabelw}#2\end{minipage}%
  \par\vspace{2pt}%
}

\begin{document}

% ============================== HEADER ==============================
\begin{center}
{\LARGE\bfseries << basics['name'] >>}\\[2pt]
<< contact_line >>\\[1pt]
<< links_line >>
<% if basics.get('authorization') %>
\\[1pt]
<< basics['authorization'] >>
<% endif %>
\end{center}

<% if achievements %>
% ========================== KEY ACHIEVEMENTS ==========================
\section*{KEY ACHIEVEMENTS}
\begin{itemize}
<% for a in achievements %>
  \item << a >>
<% endfor %>
\end{itemize}
<% endif %>

<% if education %>
% ============================= EDUCATION =============================
\section*{EDUCATION}
<% for ed in education %>
\entryhead{<< ed['institution'] >>}{<< ed['dates'] >>}
\noindent\textit{<< ed['degree'] >>}<% if ed.get('gpa') %>\hfill\textit{GPA: << ed['gpa'] >>}<% endif %>\par<% if not loop.last %>\vspace{8pt}<% endif %>

<% endfor %>
<% endif %>

<% if skills %>
% ========================== TECHNICAL SKILLS ==========================
\section*{TECHNICAL SKILLS}

<% for row in skills %>
\skillrow{<< row['label'] >>}{<< row['items'] | join(', ') >>}
<% endfor %>
<% endif %>

<% if experience %>
% ====================== PROFESSIONAL EXPERIENCE ======================
\section*{PROFESSIONAL EXPERIENCE}
<% for job in experience %>

\entryhead{<< job['org'] >>}{<< job['dates'] >>}
\textit{<< job['role'] >><% if job.get('location') %>, << job['location'] >><% endif %>}
<% if job.get('bullets') %>
\begin{itemize}
<% for b in job['bullets'] %>
  \item << b >>
<% endfor %>
\end{itemize}
<% endif %>
<% endfor %>
<% endif %>

<% if projects %>
% ============================== PROJECTS ==============================
\section*{PROJECTS}
<% for p in projects %>

\entryhead{<< p['name'] >>}{<< p['dates'] >>}
\textit{<< p['stack'] | join(', ') >><% if p.get('demo') %> \textbar{} << render_link(p['demo'], 'Demo') >><% elif p.get('link') %> \textbar{} << render_link(p['link'], 'Code') >><% endif %>}
\begin{itemize}
<% for b in p['bullets'] %>
  \item << b >>
<% endfor %>
\end{itemize}
<% endfor %>
<% endif %>

\end{document}
